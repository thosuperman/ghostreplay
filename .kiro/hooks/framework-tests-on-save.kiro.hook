{
  "enabled": true,
  "name": "Run framework guarantee tests",
  "description": "When a file in the shared ghostreplay framework changes, run its guarantee test suite and fix regressions before continuing.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["packages/ghostreplay/src/**/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file in the shared ghostreplay framework changed. Run `uv run pytest packages/ghostreplay -q`. If anything fails, explain which guarantee broke (deterministic replay, divergence detection, offline guard, redaction, fault semantics, diff) and fix the code, not the test, unless the test is wrong."
  }
}
