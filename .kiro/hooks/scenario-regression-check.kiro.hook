{
  "enabled": true,
  "name": "Re-run scenario regressions",
  "description": "When an agent harness or scenario changes in either app, re-run the scenario tests and the committed regression cases.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["apps/support-agent/src/**/*.py", "apps/devops-agent/src/**/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "An agent app changed. Run `uv run pytest apps tests/regression -q`. Confirm: the vulnerable variant still FAILS its flagship invariant (the detector works) and the fixed variant PASSES. Report any change in invariant outcomes."
  }
}
