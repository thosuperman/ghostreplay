{
  "enabled": true,
  "name": "Keep dashboard types in sync with schema",
  "description": "When the Python execution schema changes, update the dashboard TypeScript types.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["packages/ghostreplay/src/ghostreplay/models/*.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The GhostReplay schema in packages/ghostreplay/src/ghostreplay/models changed. Update apps/dashboard/src/api/types.ts to mirror it exactly, bump SCHEMA_VERSION if the change is not backward compatible, then run `pnpm --dir apps/dashboard build`."
  }
}
