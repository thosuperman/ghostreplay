{
  "enabled": true,
  "name": "Secret and side-effect review",
  "description": "Before committing fixtures or traces, check for secrets and real side-effecting clients.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/*.json", "apps/**/environment.py", "apps/**/tools.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited file against .kiro/steering/security.md: no real credentials or secret-looking values, no imports of boto3/stripe/requests/httpx clients pointed at real services, every destructive tool backed by a simulated service. Report violations and fix them."
  }
}
