# Copy to .env (never commit .env). Every variable is optional:
# with none set, GhostReplay runs the offline demo with scripted models.

# --- Live AI mode (optional; costs money per call) -----------------------------
# GHOSTREPLAY_LIVE=1
# GHOSTREPLAY_LIVE_PROVIDER=anthropic
# GHOSTREPLAY_LIVE_MODEL=claude-opus-5-5
# GHOSTREPLAY_LIVE_EFFORT=medium
# GHOSTREPLAY_LIVE_MAX_CALLS=12
# ANTHROPIC_API_KEY=

# --- Storage / serving ----------------------------------------------------------
# GHOSTREPLAY_DB_DIR=.ghostreplay
# GHOSTREPLAY_DASHBOARD_DIR=apps/dashboard/dist
# GHOSTREPLAY_CORS_ORIGINS=http://localhost:5173

# --- Public deployment profile --------------------------------------------------
# GHOSTREPLAY_PUBLIC=1                     # rate limits, no clearing, live mode off
# GHOSTREPLAY_TRUST_PROXY=1                # use X-Forwarded-For behind a proxy
# GHOSTREPLAY_RATE_LIMIT_PER_MINUTE=30
# GHOSTREPLAY_MAX_CONCURRENT_RUNS=2
# GHOSTREPLAY_MAX_EXECUTIONS=400
# GHOSTREPLAY_MAX_BODY_BYTES=524288
