# /etc/ghostreplay/ghostreplay.env — shared by both lab services. No secrets belong here.
GHOSTREPLAY_PUBLIC=1
GHOSTREPLAY_TRUST_PROXY=1
GHOSTREPLAY_CORS_ORIGINS=https://ghostreplay.hayaix.tech
GHOSTREPLAY_RATE_LIMIT_PER_MINUTE=30
GHOSTREPLAY_MAX_CONCURRENT_RUNS=2
GHOSTREPLAY_MAX_BODY_BYTES=524288
GHOSTREPLAY_MAX_EXECUTIONS=2000
GHOSTREPLAY_MAX_EXECUTIONS_PER_SESSION=80
GHOSTREPLAY_SESSION_TTL_HOURS=24
GHOSTREPLAY_MAX_STREAM_DELAY_MS=400
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
