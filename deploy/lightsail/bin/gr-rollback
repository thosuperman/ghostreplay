#!/usr/bin/env bash
# gr-rollback [release-id]
# Re-activate an earlier release (default: the newest one other than `current`).
# Data is not rolled back; use gr-restore for that.
set -euo pipefail
here=$(dirname "$(realpath "$0")")
if [ -f "$here/gr-common.sh" ]; then source "$here/gr-common.sh"; else source /usr/local/lib/ghostreplay/gr-common.sh; fi
need_root
current=$(readlink -e "$GR_CURRENT") || die "no active release"
if [ $# -ge 1 ]; then
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid release id"
  target=$GR_RELEASES/$1
else
  target=$(ls -1dt "$GR_RELEASES"/*/ | sed 's#/$##' | grep -vxF "$current" | head -n1 || true)
fi
if [ -z "${target:-}" ] || [ ! -d "$target" ]; then die "no release to roll back to"; fi
log "rolling back from $(basename "$current") to $(basename "$target")"
# Activate with the target release's own scripts (its config is what gets reinstalled).
exec "$target/deploy/lightsail/bin/gr-activate" "$target"
